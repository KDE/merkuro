<knut>
  <collection rid="contacts" name="Contacts" content="inode/directory,text/directory">
    <attribute type="AccessRights">wcW</attribute>
    <item rid="ada" mimetype="text/directory">
      <payload>
BEGIN:VCARD
VERSION:3.0
UID:ada-lovelace
FN:Ada Lovelace
N:Lovelace;Ada;;;
EMAIL:ada@example.org
END:VCARD
      </payload>
    </item>
    <item rid="friends" mimetype="application/x-vnd.kde.contactgroup">
      <payload><![CDATA[
        <contactGroup uid="friends" name="KDE Friends">
          <contactData name="Grace Hopper" email="grace@example.org"/>
        </contactGroup>
      ]]></payload>
    </item>
  </collection>
  <collection rid="other-contacts" name="Other Contacts" content="inode/directory,text/directory">
    <attribute type="AccessRights">wcW</attribute>
  </collection>
</knut>
